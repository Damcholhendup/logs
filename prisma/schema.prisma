datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Log {
  id              Int      @id @default(autoincrement())
  ticketNumber    String   @unique
  errorCode       Int?
  errorMessage    String
  timestamp       DateTime @default(now())
  deviceInfo      String
  errorTitle      String
  userDescription String
  stackTraceReport String?  // File path or URL
}
